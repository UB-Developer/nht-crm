# Environment Configuration for Hajj & Umrah CRM + ERP

# Active Database (SQLite for immediate local development / out-of-the-box run)
DATABASE_URL="file:./dev.db"

# For PostgreSQL production deployment, uncomment and replace:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/hajj_umrah_crm?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-jwt-key-for-hajj-umrah-crm-2026-production"

# Application Settings
NEXT_PUBLIC_APP_NAME="Al-Haramain Travel & Umrah ERP"
NEXT_PUBLIC_DEFAULT_CURRENCY="PKR"
NEXT_PUBLIC_COUNTRY="Pakistan"
